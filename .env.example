PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/market.sqlite
APP_ORIGIN=http://localhost:5173
# Set production only behind HTTPS; session cookies then require HTTPS.
NODE_ENV=development

# Reverse proxy hops: 0 for local development, 1 for Render.
TRUST_PROXY_HOPS=0
# Only needed when creating the first administrator on a fresh deployment.
# Enter real values in Render Environment, never commit them to Git.
# ADMIN_NAME=Quản trị Cận
# ADMIN_EMAIL=your-email@example.com
# ADMIN_PASSWORD=your-own-password-at-least-12-characters
